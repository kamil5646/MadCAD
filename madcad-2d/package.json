{
  "name": "madcad-desktop",
  "version": "6.4.1",
  "description": "Desktopowy CAD 2D/3D: klasyczne szkicowanie, parametryczna historia i modelowanie bryłowe.",
  "desktopName": "MadCAD",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamil5646/MadCAD.git"
  },
  "main": "electron/main.js",
  "author": "Kamil Kasprzak",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "npm run serve & env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "serve": "vite",
    "build": "npm run build:ui",
    "build:ui": "vite build",
    "verify:modeling": "npm run build:ui && electron scripts/verify-modeling.cjs",
    "verify:model-import": "npm run build:ui && electron scripts/verify-model-import.cjs",
    "verify:viewport-navigation": "npm run build:ui && electron scripts/verify-viewport-navigation.cjs",
    "verify:external-compatibility": "npm run build:ui && electron scripts/verify-external-compatibility.cjs",
    "verify:start-experience": "npm run build:ui && electron scripts/verify-start-experience.cjs",
    "verify:ribbon": "npm run build:ui && electron scripts/verify-ribbon-overflow.cjs",
    "verify:command-line": "npm run build:ui && electron scripts/verify-command-line.cjs",
    "verify:panels": "npm run build:ui && electron scripts/verify-docked-panels.cjs",
    "verify:timeline": "npm run build:ui && electron scripts/verify-timeline-management.cjs",
    "verify:snapshots": "npm run build:ui && electron scripts/verify-project-snapshots.cjs",
    "verify:project-diff": "npm run build:ui && electron scripts/verify-project-snapshots.cjs",
    "verify:project-health": "npm run build:ui && electron scripts/verify-project-health.cjs",
    "verify:project-dependencies": "npm run build:ui && electron scripts/verify-project-dependencies.cjs",
    "verify:project-search": "npm run build:ui && electron scripts/verify-project-search.cjs",
    "verify:linked-projects": "npm run build:ui && electron scripts/verify-linked-projects.cjs",
    "verify:pack-and-go": "npm run build:ui && electron scripts/verify-linked-projects.cjs",
    "verify:reference-repair": "npm run build:ui && electron scripts/verify-reference-repair-wizard.cjs",
    "verify:layers": "npm run build:ui && electron scripts/verify-layers.cjs",
    "verify:blocks": "npm run build:ui && electron scripts/verify-blocks.cjs",
    "verify:components": "npm run build:ui && electron scripts/verify-components.cjs",
    "verify:command-customization": "npm run build:ui && electron scripts/verify-command-customization.cjs",
    "verify:constraint-suggestions": "npm run build:ui && electron scripts/verify-constraint-suggestions.cjs",
    "verify:under-constraint": "npm run build:ui && electron scripts/verify-under-constraint.cjs",
    "verify:hole-standards": "npm run build:ui && electron scripts/verify-hole-standards.cjs",
    "verify:draft-analysis": "npm run build:ui && electron scripts/verify-draft-analysis.cjs",
    "verify:named-views": "npm run build:ui && electron scripts/verify-named-views.cjs",
    "verify:import-report": "npm run build:ui && electron scripts/verify-import-report.cjs",
    "verify:workspace-layouts": "npm run build:ui && electron scripts/verify-workspace-layouts.cjs",
    "verify:drawing-workspace": "npm run build:ui && electron scripts/verify-drawing-workspace.cjs",
    "verify:assistive-tech": "npm run build:ui && electron scripts/verify-assistive-tech.cjs",
    "verify:snap-feedback": "npm run build:ui && electron scripts/verify-snap-feedback.cjs",
    "verify:electron-security": "electron scripts/verify-electron-security.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:release-version": "node scripts/verify-release-version.cjs",
    "verify:repository": "node scripts/verify-repository.cjs",
    "checksums:package": "node scripts/create-package-checksums.cjs",
    "test:core": "node --test tests/cad-core.test.mjs",
    "test:core:coverage": "node --experimental-test-coverage --test-coverage-include='src/cad-core/*.js' --test-coverage-lines=90 --test-coverage-branches=65 --test-coverage-functions=90 --test tests/cad-core.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "start": "npm run build:ui && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "npm run build:ui && electron-builder --mac dir --win nsis --x64",
    "dist:mac": "npm run build:ui && electron-builder --mac dir",
    "dist:mac:trusted": "npm run dist:mac:unsigned",
    "dist:mac:unsigned": "npm run build:ui && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:dmg": "npm run build:ui && electron-builder --mac dmg --arm64 --publish never",
    "dist:win:trusted": "npm run dist:win:unsigned",
    "dist:win:unsigned": "npm run build:ui && electron-builder --win nsis zip --x64 --publish never",
    "dist:win:portable": "npm run build:ui && electron-builder --win zip --x64 --publish never",
    "dist:linux:trusted": "npm run build:ui && electron-builder --linux AppImage --x64 --publish never",
    "dist:release:trusted": "npm run dist:mac:trusted && npm run dist:win:trusted && npm run dist:linux:trusted",
    "dist:win": "npm run dist:win:unsigned",
    "dist:dir": "npm run build:ui && electron-builder --dir"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "^4.10.3",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.11.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "pl.kamilkasprzak.madcad2d",
    "productName": "MadCAD",
    "asar": true,
    "artifactName": "MadCAD-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "LICENSE",
      "EULA.md",
      "COPYRIGHT.md",
      "PRIVACY.md",
      "THIRD_PARTY_NOTICES.md",
      "electron/**/*",
      "README.md",
      "FIRST_PART.md",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kamil5646",
        "repo": "MadCAD",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/madcad.icns",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icons/madcad.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/madcad-512.png",
      "category": "Graphics",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MadCAD",
      "uninstallDisplayName": "MadCAD",
      "deleteAppDataOnUninstall": false
    },
    "afterSign": "scripts/notarize.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "manifold-3d": "^3.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "replicad": "^0.23.1",
    "replicad-opencascadejs": "^0.23.0",
    "three": "^0.185.1"
  }
}
