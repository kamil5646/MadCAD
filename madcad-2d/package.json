{
  "name": "madcad-desktop",
  "version": "7.3.4",
  "description": "Desktopowy CAD 2D/3D: klasyczne szkicowanie, parametryczna historia i modelowanie bryłowe.",
  "desktopName": "MadCAD",
  "repository": {
    "type": "git",
    "url": "https://github.com/kamil5646/MadCAD.git"
  },
  "main": "electron/main.js",
  "author": "Kamil Kasprzak",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "npm run serve & env -u ELECTRON_RUN_AS_NODE VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "serve": "vite",
    "build": "npm run build:ui",
    "audit:deps": "node scripts/audit-dependencies.cjs",
    "build:ui": "vite build",
    "verify:desktop-suite": "npm run build:ui && node scripts/run-desktop-verification-suite.cjs",
    "verify:desktop-suite:prepared": "node scripts/run-desktop-verification-suite.cjs",
    "verify:product-completeness": "node scripts/verify-product-completeness.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "verify:packaged-startup": "node scripts/verify-packaged-startup.cjs",
    "verify:release-version": "node scripts/verify-release-version.cjs",
    "verify:repository": "node scripts/verify-repository.cjs",
    "checksums:package": "node scripts/create-package-checksums.cjs",
    "test:core": "node --test tests/cad-core.test.mjs",
    "test:license": "node --test electron/license-client.test.cjs",
    "test:import-file": "node --test electron/import-file.test.cjs",
    "test:core:coverage": "node --experimental-test-coverage --test-coverage-include='src/cad-core/*.js' --test-coverage-lines=90 --test-coverage-branches=65 --test-coverage-functions=90 --test tests/cad-core.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "start": "npm run build:ui && env -u ELECTRON_RUN_AS_NODE electron .",
    "dist": "npm run build:ui && electron-builder --mac dir --win nsis --x64",
    "dist:mac": "npm run build:ui && electron-builder --mac dir",
    "dist:mac:trusted": "npm run dist:mac:unsigned",
    "dist:mac:unsigned": "npm run build:ui && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:dmg": "npm run build:ui && electron-builder --mac dmg --arm64 --publish never",
    "dist:win:trusted": "npm run dist:win:unsigned",
    "dist:win:unsigned": "npm run build:ui && electron-builder --win nsis zip --x64 --publish never",
    "dist:win:portable": "npm run build:ui && electron-builder --win zip --x64 --publish never",
    "dist:linux:trusted": "npm run build:ui && electron-builder --linux AppImage --x64 --publish never",
    "dist:release:trusted": "npm run dist:mac:trusted && npm run dist:win:trusted && npm run dist:linux:trusted",
    "dist:win": "npm run dist:win:unsigned",
    "dist:dir": "npm run build:ui && electron-builder --dir",
    "verify:studio": "npm run build:ui && electron scripts/verify-studio.cjs",
    "verify:electron-security": "electron scripts/verify-electron-security.cjs"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "^4.13.0",
    "electron": "43.8.4",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.13.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "manifold-3d": "3.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "pl.kamilkasprzak.madcad2d",
    "productName": "MadCAD",
    "asar": true,
    "artifactName": "MadCAD-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "LICENSE",
      "EULA.md",
      "COPYRIGHT.md",
      "PRIVACY.md",
      "THIRD_PARTY_NOTICES.md",
      "electron/**/*",
      "README.md",
      "FIRST_PART.md",
      "package.json",
      "!node_modules/**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kamil5646",
        "repo": "MadCAD",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icons/madcad.icns",
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icons/madcad.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/madcad-512.png",
      "category": "Graphics",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MadCAD",
      "uninstallDisplayName": "MadCAD",
      "deleteAppDataOnUninstall": false
    },
    "afterSign": "scripts/notarize.js"
  }
}
